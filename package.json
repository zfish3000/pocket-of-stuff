{
  "name": "pocket-of-stuff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:projects": "node scripts/generate-project-manifest.mjs",
    "randomize:projects": "node scripts/randomize-project-blocks.mjs && npm run generate:projects",
    "dev": "npm run generate:projects && vite",
    "build": "npm run generate:projects && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "matter-js": "^0.20.0",
    "parse5": "^7.2.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20.19.43",
    "jsdom": "^24.1.3",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
